# Copy to .env for local development.
# Keep real credentials out of Git.

APP_ENV=development
APP_URL=http://localhost:3102
FRONTEND_HOST=0.0.0.0
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3102
BACKEND_PORT=8102
MEDIA_PORT=8202
ADMIN_PORT=9102
WEBSOCKET_PORT=8302
API_PORT=8102
VITE_API_BASE_URL=http://127.0.0.1:8102
VITE_MEDIA_BASE_URL=http://localhost:8202
DATA_DIR=./data
SQLITE_PATH=./data/app.sqlite

# Browser capture behavior
# false = visible browser window for manual login/debugging.
# true = background headless capture.
CAPTURE_HEADLESS=false
CAPTURE_TIMEOUT_MS=30000
CAPTURE_SETTLE_MS=2500
CAPTURE_VIDEO_LIMIT=30

# Example only:
# OPENAI_API_KEY=sk-example-replace-me
# DATABASE_URL=postgresql://user:password@localhost:5432/app
